# Gemini API key from https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=

# gemini-3.5-flash is fastest of the working models (2.1s vs 3.6-flash's 10.3s).
# 3.7-flash returns 503 under load; 2.5-flash is 404 for new keys.
SETU_LLM_MODEL=gemini-3.5-flash-lite

# auto | offline -- run the live demo on "offline" to serve only from cache
SETU_LLM_MODE=auto

# Measured on one Hindi sentence: small 4.9s, medium 14.4s. Small garbles the
# spelling of spoken numbers, but extraction reads it correctly anyway, so the
# accuracy medium buys is no longer worth ten seconds of somebody waiting.
# Never "base" -- it transcribes Hindi speech into Urdu script.
SETU_WHISPER_SIZE=small
